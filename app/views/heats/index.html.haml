%h1= "#{@competition} - Heat Assignment"

%table.competitor_statuses.sortable
  %caption Competitors
  %thead
    %tr
      %th Heat
      %th Lane
      %th.sign_up ID
      %th.sign_up Name
      %th.sign_up Age
      %th.sign_up Gender
      %th Age Group
      %th Age Group order
      %th Best Time
      %th Best Time value
  %tbody
    - age_group_orders = @competition.age_groups.each_with_index.to_h { |age_group, index| [age_group, index + 1] }
    - @competitors.find_each(batch_size: 100) do |competitor|
      %tr
        %th= competitor.heat
        %th= competitor.lane
        %td= competitor.lowest_member_bib_number
        %td= competitor.to_s
        %td= competitor.age
        %td= competitor.gender
        %td= competitor.age_group_entry_description
        %th= age_group_orders[competitor.age_group]
        %td= competitor.best_time
        %td= competitor.best_time.try(:value)
%br

= link_to "set heats/lanes", new_competition_heat_path(@competition)
%br
= link_to "delete all lane assignments", destroy_all_competition_heats_path(@competition), method: :delete, data: { confirm: "remove all heat/lane assignments?" }
%br

%h3 Manually Sort Age Groups
- @competition.age_groups.each do |age_group|
  = link_to "Manually Sort #{age_group}", set_sort_competition_heats_path(@competition, age_group.to_age_group_param)
  %br
%hr

%br
= link_to "Back", @competition
