- if @competition.can_calculated_age_group_results?
  = form_tag set_age_group_places_competition_path(@competition), method: :post do
    .row
      .small-6.columns
        = select_tag :age_group, options_for_select(@competition.age_groups.map { |age_group| [age_group.to_s, age_group.to_age_group_param] }), :include_blank => true
      .small-6.columns
        = submit_tag "Set Single Age Group", class: "button tiny", data: { confirm: "Set single age group entry?" }
