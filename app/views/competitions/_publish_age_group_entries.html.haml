- if policy(@competition).publish_age_group_entry?
  - if @competition.has_age_group_entry_results?
    %h2 Preliminary Age Group Entry Results
    %table
      %thead
        %tr
          %th Age Group
          %th Preview
          %th Publish
          %th Published-At
      %tbody
        - @competition.age_groups.each do |age_group|
          - published_entry = @competition.published_age_group_entry_for(age_group)
          %tr
            %td= age_group
            %td
              = link_to "Preview", preview_competition_published_age_group_entry_path(@competition, age_group.to_age_group_param)
              = link_to "(pdf)", preview_competition_published_age_group_entry_path(@competition, age_group.to_age_group_param, format: :pdf)
            %td= link_to "Publish", publish_age_group_entry_competition_path(@competition, age_group: age_group.to_age_group_param), method: :post, data: { confirm: "are you sure?" }, class: "button tiny"
            %td
              - if published_entry
                = link_to published_entry, competition_published_age_group_entry_path(@competition, published_entry), title: "published at #{published_entry.published_formatted}"
                = link_to "(pdf)", competition_published_age_group_entry_path(@competition, published_entry,  format: :pdf), title: "published at #{published_entry.published_formatted}"
