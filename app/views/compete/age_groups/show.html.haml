%h1= t(".title", competition: @competition)

%p= t(".headline", competitors_count: @competition.competitors.active.count)

- age_group_data = @competition.registrant_age_group_data

.js--hiddenToggleMenu.button.secondary= t(".show_registrant_sign_up_breakdown")
.js--hiddenToggle.is--hidden
  .row
    .small-12.medium-6.columns
      %h3= t(".male")
      = render "registrant_age_group_entries", entries: age_group_data.select { |element| element[:gender] == "Male" }

    .small-12.medium-6.columns
      %h3= t(".female")
      = render "registrant_age_group_entries", entries: age_group_data.select { |element| element[:gender] == "Female" }

- combiner = AgeGroupCombiner.new(@competition)

.row
  .small-12.medium-6.columns
    %h2= t(".base_age_groups", age_group_type: @age_group_type)

    = render "age_group_entries", age_group_type: @age_group_type, competition: @competition, age_group_data: age_group_data

  .small-12.medium-6.columns
    %h2= t(".ranking_age_groups")
    - if @competition.age_group_combinations.any?
      %p= t(".age_group_type_locked", age_group_type: @age_group_type)
    %p
      = t(".order_hint")
      - if @competition.custom_age_group_order?
        = t(".custom_order", age_group_type: @age_group_type)
        = link_to t(".reset_order"), reset_order_competition_age_groups_path(@competition), method: :put, class: "button tiny secondary", data: { confirm: t(".are_you_sure") }

    %table.js--sortable{ data: { target: update_row_order_competition_age_groups_path(@competition) } }
      %thead
        %tr
          %th= t(".entry")
          %th= t(".eligible_registrants")
          %th= t(".ineligible_registrants")
          %th= t(".action")
      %tbody
        - @competition.age_groups.each do |age_group|
          - eligible_registrants = age_group.number_eligible_matching_registrant(age_group_data)
          %tr.item{ data: { item_id: age_group.to_age_group_param } }
            %td
              - if age_group.is_a?(AgeGroupCombination)
                -# The full name is displayed, and replaced by the rename form when editing it
                .js--inlineEdit
                  .js--inlineEditDisplay
                    = age_group
                    = link_to "✎", "#", class: "js--inlineEditOpen", title: t(".rename"), aria: { label: t(".rename") }
                  = form_tag rename_competition_age_groups_path(age_group_combination_id: age_group.id), method: :put, class: "js--inlineEditForm is--hidden" do
                    = text_field_tag :name, age_group.short_description, placeholder: age_group.generated_name, id: "age_group_combination_#{age_group.id}_name", title: t(".name_hint")
                    = submit_tag t(".rename"), class: "button tiny secondary"
                    = link_to t(".cancel"), "#", class: "js--inlineEditCancel"
              - else
                = age_group
            %td= eligible_registrants
            %td= age_group.number_ineligible_matching_registrant(age_group_data)
            %td
              - if eligible_registrants < 6
                - smallest_neighbour = combiner.smallest_neighbour(age_group, age_group_data)
                - if smallest_neighbour
                  %p
                    = link_to t(".combine_with", smallest_neighbour: smallest_neighbour), combine_competition_age_groups_path(age_groups: [age_group.to_age_group_param, smallest_neighbour.to_age_group_param]), method: :put, data: { confirm: t(".are_you_sure") }
              - if age_group.is_a?(AgeGroupCombination)
                %p
                  = link_to t(".separate"), separate_competition_age_groups_path(age_group_combination_id: age_group.id), method: :put, data: { confirm: t(".are_you_sure") }
